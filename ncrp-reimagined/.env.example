# Required for persistent accounts and incidents on Vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required for signing authentication cookies
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional provider integrations; local fallbacks work without them
OPENAI_API_KEY=
SARVAM_API_KEY=
SARVAM_CHAT_API_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_CHAT_MODEL=sarvam-m

# Copy to .env.local and fill with replacement credentials.
# Never commit .env.local or paste API keys into source, screenshots, or CODEX.md.
OPENAI_API_KEY=
OPENAI_MODEL=
SARVAM_API_KEY=
SARVAM_CHAT_API_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_CHAT_MODEL=sarvam-m
